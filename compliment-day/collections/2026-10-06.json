[
  {
    "text": "Вы великолепная, чудная женщина.",
    "author": "Антон Чехов",
    "work": "Три сестры",
    "source_url": "https://ru.wikisource.org/wiki/Три_сестры_(Чехов)/Действие_второе"
  },
  {
    "text": "И в каждом слове мысль, и в каждом взоре чувство!",
    "author": "Денис Давыдов",
    "work": "Ей (подражание Вольтеру)",
    "source_url": "https://slova.org.ru/davydov/ej/"
  },
  {
    "text": "Мне близ тебя хорошо и поётся.",
    "author": "Афанасий Фет",
    "work": "Свеж и душист твой роскошный венок",
    "source_url": "https://ru.wikisource.org/wiki/Свеж_и_душист_твой_роскошный_венок_(Фет)"
  },
  {
    "text": "Вы просто чудо красоты!",
    "author": "Николай Языков",
    "work": "А. В. Киреевой",
    "source_url": "https://ru.wikisource.org/wiki/А._В._Киреевой_(Тогда_как_сердцем_мы_лелеем_—_Языков)"
  },
  {
    "text": "У вас есть талант, берегите его, растите его!",
    "author": "Александр Островский",
    "work": "Таланты и поклонники",
    "source_url": "https://ru.wikisource.org/wiki/Таланты_и_поклонники_(Островский)/Версия_2"
  },
  {
    "text": "Ты, как звезды, чиста и прекрасна…",
    "author": "Иван Бунин",
    "work": "Звезды ночью весенней нежнее…",
    "source_url": "https://www.culture.ru/poems/27211/zvezdy-nochyu-vesennei-nezhnee"
  },
  {
    "text": "Твой смех упоительно-звучен.",
    "author": "Константин Бальмонт",
    "work": "Польской девушке",
    "source_url": "https://ru.wikisource.org/wiki/Польской_девушке_(Бальмонт)"
  },
  {
    "text": "Утешала ты меня.",
    "author": "Фёдор Сологуб",
    "work": "Ирина",
    "source_url": "https://www.culture.ru/poems/22007/irina"
  },
  {
    "text": "И счастлив тем, что вы прекрасны.",
    "author": "Евгений Баратынский",
    "work": "К… (Мне с упоением заметным…)",
    "source_url": "https://ru.wikisource.org/wiki/К…_(Мне_с_упоением_заметным_—_Боратынский)"
  }
]
